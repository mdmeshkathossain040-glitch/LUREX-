# ============================================================================
# LUREX Multi-Vendor Marketplace Backend Environment Variables
# ============================================================================

PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://lurex_user:lurex_password@localhost:5432/lurex_db

# Security & JWT
JWT_SECRET=production_jwt_secret_change_in_production_key_32bytes_min
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=production_refresh_secret_change_in_production_32bytes
REFRESH_TOKEN_EXPIRES_IN=7d

# Marketplace Commission (5% = 0.05)
MARKETPLACE_COMMISSION_RATE=0.05

# Payment Providers (Bangladesh MFS & Banks)
# REQUIRES REAL PRODUCTION CREDENTIALS in production mode
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=sandbox_bkash_app_key_placeholder
BKASH_APP_SECRET=sandbox_bkash_app_secret_placeholder
BKASH_USERNAME=sandbox_bkash_user
BKASH_PASSWORD=sandbox_bkash_pass

NAGAD_BASE_URL=https://api.mynagad.com/api/dfs
NAGAD_MERCHANT_ID=sandbox_nagad_merchant_id
NAGAD_MERCHANT_KEY=sandbox_nagad_merchant_key
NAGAD_PUBLIC_KEY=sandbox_nagad_public_key

ROCKET_BASE_URL=https://api.rocket.com.bd/v1
ROCKET_MERCHANT_ID=sandbox_rocket_merchant_id
ROCKET_MERCHANT_SECRET=sandbox_rocket_merchant_secret

# Object Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_BUCKET=lurex-product-images
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_PUBLIC_URL=https://cdn.lurex.com.bd
